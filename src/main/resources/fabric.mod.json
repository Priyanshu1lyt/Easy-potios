  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.easygamemode.EasyGamemodeClient"]
  },
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
